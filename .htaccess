Options -Indexes

# Runtime PHP/CSS/JS stays available. Development/debug artifacts do not.
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(log|sql|zip|bak|old|ini|env)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(log|sql|zip|bak|old|ini|env)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
